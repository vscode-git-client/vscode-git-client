    const commitContextMenu = (() => {
      const menu = document.getElementById('commit-context-menu');
      const menuItems = Array.from(menu.querySelectorAll('.menu-item[data-action]'));
      const initiallyDisabled = new Set(
        menuItems
          .filter((item) => item.disabled)
          .map((item) => item.getAttribute('data-action') || '')
          .filter(Boolean)
      );
      const multiSelectActions = new Set([
        'openDetails',
        'copyCommitId',
        'copyCommitMessage',
        'createPatch',
        'cherryPick',
        'revertCommit'
      ]);
      const singularLabels = {
        openDetails: 'Open Details',
        copyCommitId: 'Copy Commit Hash',
        copyCommitMessage: 'Copy Commit Message',
        createPatch: 'Create Patch...',
        cherryPick: 'Cherry-Pick',
        revertCommit: 'Revert Commit'
      };
      const pluralLabels = {
        openDetails: (n) => `Open Details (${n} Commits)`,
        copyCommitId: (n) => `Copy Commit Hashes (${n})`,
        copyCommitMessage: (n) => `Copy Commit Messages (${n})`,
        createPatch: (n) => `Create Patch for ${n} Commits...`,
        cherryPick: (n) => `Cherry-Pick ${n} Commits`,
        revertCommit: (n) => `Revert ${n} Commits`
      };
      let selectedShas = [];
      let selectedSubjects = [];

      const normalizeShas = (rawValues) =>
        Array.from(new Set((Array.isArray(rawValues) ? rawValues : [])
          .map((value) => (typeof value === 'string' ? value.trim() : ''))
          .filter(Boolean)));
      const normalizeSubjects = (rawValues) =>
        Array.from(new Set((Array.isArray(rawValues) ? rawValues : [])
          .map((value) => (typeof value === 'string' ? value.trim() : ''))
          .filter(Boolean)));

      const applyActionAvailability = () => {
        const isMulti = selectedShas.length > 1;
        let continuous = false;
        if (isMulti) {
          try {
            continuous = typeof isContinuousSelection === 'function' ? isContinuousSelection() : false;
          } catch (e) {
            // Ignore if not defined or in TDZ
          }
        }
        const nonChangeActions = new Set(['copyCommitId', 'copyCommitMessage']);

        menuItems.forEach((item) => {
          const action = item.getAttribute('data-action') || '';
          if (!action) {
            return;
          }
          if (initiallyDisabled.has(action)) {
            item.disabled = true;
            return;
          }

          if (isMulti) {
            if (continuous) {
              item.disabled = !multiSelectActions.has(action);
            } else {
              item.disabled = !nonChangeActions.has(action);
            }
          } else {
            item.disabled = false;
          }
        });

        applyActionLabels(isMulti ? selectedShas.length : 1);
      };

      const applyActionLabels = (count) => {
        menuItems.forEach((item) => {
          const action = item.getAttribute('data-action') || '';
          if (!action || !Object.prototype.hasOwnProperty.call(singularLabels, action)) {
            return;
          }
          item.textContent =
            count > 1 ? pluralLabels[action](count) : singularLabels[action];
        });
      };

      const close = () => {
        menu.classList.remove('visible');
        selectedShas = [];
        selectedSubjects = [];
        applyActionAvailability();
      };

      const open = (x, y, payload) => {
        selectedShas = normalizeShas(payload && payload.shas);
        selectedSubjects = normalizeSubjects(payload && payload.subjects);
        if (selectedShas.length === 0) {
          return;
        }
        applyActionAvailability();
        menu.style.left = '0px';
        menu.style.top = '0px';
        menu.classList.add('visible');

        const menuRect = menu.getBoundingClientRect();
        const viewport = window.visualViewport;
        const viewportLeft = viewport ? viewport.offsetLeft : 0;
        const viewportTop = viewport ? viewport.offsetTop : 0;
        const viewportWidth = viewport ? viewport.width : window.innerWidth;
        const viewportHeight = viewport ? viewport.height : window.innerHeight;

        const minX = viewportLeft + 8;
        const minY = viewportTop + 8;
        const maxX = Math.max(minX, viewportLeft + viewportWidth - menuRect.width - 8);
        const maxY = Math.max(minY, viewportTop + viewportHeight - menuRect.height - 8);
        const targetX = Math.max(minX, Math.min(x, maxX));
        const targetY = Math.max(minY, Math.min(y, maxY));

        menu.style.left = targetX + 'px';
        menu.style.top = targetY + 'px';
      };

      const openForRow = (event, row) => {
        event.preventDefault();
        const payloadShas = normalizeShas(row && row._vscodeGitClientSelectedShas);
        const payloadSubjects = normalizeSubjects(row && row._vscodeGitClientSelectedSubjects);
        if (payloadShas.length > 0) {
          open(event.clientX, event.clientY, { shas: payloadShas, subjects: payloadSubjects });
          return;
        }
        const rowSha = row.getAttribute('data-sha') || '';
        const rowSubject = row.getAttribute('data-subject') || '';
        if (rowSha) {
          open(event.clientX, event.clientY, { shas: [rowSha], subjects: rowSubject ? [rowSubject] : [] });
        }
      };

      const contains = (target) => menu.contains(target);
      const isVisible = () => menu.classList.contains('visible');

      menu.addEventListener('click', (event) => {
        const target = event.target && event.target.closest ? event.target.closest('.menu-item[data-action]') : null;
        if (!target || target.disabled || selectedShas.length === 0) {
          return;
        }

        const action = target.getAttribute('data-action');
        if (!action) {
          return;
        }

        const suppressAutoRefresh =
          action === 'cherryPick' &&
          typeof matchingMessagesCheckbox !== 'undefined' &&
          Boolean(matchingMessagesCheckbox && matchingMessagesCheckbox.checked);

        vscode.postMessage({
          type: 'commitAction',
          action,
          sha: selectedShas[0],
          shas: selectedShas,
          subject: selectedSubjects[0] || '',
          subjects: selectedSubjects,
          isContinuous: typeof isContinuousSelection === 'function' ? isContinuousSelection() : false,
          reverseOrder: event.shiftKey === true,
          suppressAutoRefresh
        });
        close();
      });

      window.addEventListener('blur', close);
      window.addEventListener('scroll', close, true);
      applyActionAvailability();

      return { close, contains, isVisible, openForRow };
    })();
