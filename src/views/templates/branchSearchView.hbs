{{> partials/documentStart title="Search Branches & Tags"}}
    {{> partials/styles/theme}}
    :root {
      --row-hover: color-mix(in srgb, var(--accent), transparent 85%);
      --row-active: color-mix(in srgb, var(--accent), transparent 70%);
    }
    {{> partials/styles/contextMenu minWidth="240px"}}
    {{> partials/styles/bodyBase background="var(--bg)" padding="16px 20px" gap="12px"}}
    .header {
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex-shrink: 0;
    }
    {{> partials/styles/viewHeading titleSize="15px"}}
    .search-row {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    input[type="text"] {
      flex: 1;
      padding: 8px 10px;
      font-size: 13px;
      background: var(--vscode-input-background);
      color: var(--vscode-input-foreground);
      border: 1px solid var(--vscode-input-border, var(--border));
      border-radius: 4px;
      outline: none;
    }
    input[type="text"]:focus {
      border-color: var(--accent);
    }
    .count {
      font-size: 11px;
      color: var(--muted);
      min-width: 80px;
      text-align: right;
    }
    {{> partials/styles/outlineButton
      selector="#refresh"
      padding="6px 9px"
      radius="4px"
      fontSize="14px"
      hoverBackground="color-mix(in srgb, var(--accent), transparent 90%)"
      hoverBorderColor="var(--accent)"
    }}
    #refresh {
      align-items: center;
      display: inline-flex;
      flex-shrink: 0;
      height: 32px;
      justify-content: center;
      line-height: 1;
      width: 34px;
    }
    #refresh:disabled {
      cursor: not-allowed;
      opacity: 0.55;
    }
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    #refresh.loading .refresh-icon {
      display: inline-block;
      animation: spin 0.8s linear infinite;
    }
    .list {
      flex: 1;
      overflow-y: auto;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 4px 0;
      min-height: 0;
    }
    .section {
      padding: 4px 0;
    }
    .section-title {
      padding: 6px 14px 4px;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--muted);
      font-weight: 600;
    }
    /* Table layout: icon | name | commit | author | updated [| pull/push] | actions */
    .section {
      --cols: 22px minmax(0, 1fr) 72px minmax(80px, 160px) 84px 28px;
    }
    .section.with-sync {
      --cols: 22px minmax(0, 1fr) 72px minmax(80px, 160px) 84px 76px 28px;
    }
    .row, .col-head {
      display: grid;
      grid-template-columns: var(--cols);
      align-items: center;
      column-gap: 10px;
      padding: 6px 14px;
    }
    .row {
      cursor: pointer;
      user-select: none;
    }
    .col-head {
      padding-top: 2px;
      padding-bottom: 4px;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      color: var(--muted);
      border-bottom: 1px solid var(--border);
      user-select: none;
    }
    .cell {
      font-size: 12px;
      color: var(--muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      min-width: 0;
    }
    .cell-sha {
      font-family: var(--vscode-editor-font-family, monospace);
    }
    .cell-sync {
      text-align: right;
    }
    .cell-sync .pull { color: var(--vscode-gitDecoration-modifiedResourceForeground, #e2c08d); }
    .cell-sync .push { color: var(--vscode-gitDecoration-addedResourceForeground, #89d185); }
    .row:hover, .row.focused {
      background: var(--row-hover);
    }
    .row.current {
      background: var(--row-active);
    }
    .row-icon {
      font-size: 13px;
      width: 16px;
      text-align: center;
      color: var(--muted);
      flex-shrink: 0;
    }
    .row.current .row-icon { color: var(--vscode-gitDecoration-addedResourceForeground, #89d185); }
    .row-name {
      font-size: 13px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      min-width: 0;
    }
    .row-name mark {
      background: var(--vscode-editor-findMatchHighlightBackground, rgba(255, 200, 0, 0.4));
      color: inherit;
      border-radius: 2px;
      padding: 0 1px;
    }
    .row-actions {
      display: flex;
      justify-content: flex-end;
      visibility: hidden;
    }
    .row:hover .row-actions, .row.focused .row-actions {
      visibility: visible;
    }
    {{> partials/styles/outlineButton
      selector=".row-actions button"
      padding="2px 6px"
      radius="3px"
      fontSize="10px"
      color="var(--muted)"
      hoverColor="var(--fg)"
      hoverBorderColor="var(--accent)"
    }}
    .empty {
      padding: 24px 14px;
      text-align: center;
      color: var(--muted);
      font-size: 12px;
    }
    .loading {
      padding: 24px 14px;
      text-align: center;
      color: var(--muted);
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div class="header">
    {{> partials/molecules/viewHeading
      title="Search Branches & Tags"
      hint="Type to filter branches and tags. Click a result for actions. Enter to checkout the top match. ↑/↓ to move. Esc to close."
    }}
    <div class="search-row">
      <input id="search" type="text" placeholder="Filter branches or tags…" autofocus spellcheck="false" />
      <button id="refresh" type="button" title="Refresh branches and tags" aria-label="Refresh branches and tags"><span class="refresh-icon">⟳</span></button>
      <span id="count" class="count">0 results</span>
    </div>
  </div>
  <div id="list" class="list"></div>
  {{{branchContextMenuHtml}}}

  <div id="refresh-context-menu" class="context-menu" role="menu" aria-label="Refresh context menu" style="min-width:120px">
    <button class="menu-item" data-command="refresh">Refresh</button>
  </div>

  <script>
    const vscode = acquireVsCodeApi();
    const searchInput = document.getElementById('search');
    const refreshBtn = document.getElementById('refresh');
    const listEl = document.getElementById('list');
    const countEl = document.getElementById('count');
    const branchMenu = document.getElementById('branch-context-menu');
    const tagMenu = document.getElementById('tag-context-menu');

    let branches = [];
    let tags = [];
    let filtered = { branches: [], tags: [] };
    let focusedIndex = 0;
    let selectedName = null;
    let selectedKind = null;
    let isLoading = true;

    function getMenu(kind) {
      return kind === 'tag' ? tagMenu : branchMenu;
    }

    function getActiveMenu() {
      return getMenu(selectedKind);
    }

    window.addEventListener('message', (event) => {
      const msg = event.data;
      if (msg && msg.type === 'data') {
        branches = msg.branches || [];
        tags = msg.tags || [];
        applyFilter();
        return;
      }
      if (msg && msg.type === 'loading') {
        isLoading = Boolean(msg.isLoading);
        if (refreshBtn) {
          refreshBtn.disabled = isLoading;
          refreshBtn.classList.toggle('loading', isLoading);
        }
        render(searchInput.value.trim().toLowerCase());
      }
    });

    function escapeHtml(value) {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function highlight(text, query) {
      if (!query) return escapeHtml(text);
      const lower = text.toLowerCase();
      const q = query.toLowerCase();
      const idx = lower.indexOf(q);
      if (idx < 0) return escapeHtml(text);
      return (
        escapeHtml(text.slice(0, idx)) +
        '<mark>' + escapeHtml(text.slice(idx, idx + query.length)) + '</mark>' +
        escapeHtml(text.slice(idx + query.length))
      );
    }

    function shortSha(item) {
      const sha = (item.lastCommit && item.lastCommit.sha) || item.sha || '';
      return sha.slice(0, 7);
    }

    function formatRelative(epoch) {
      if (!epoch) return '';
      const seconds = Math.max(0, Math.floor(Date.now() / 1000) - epoch);
      const units = [
        ['y', 31536000],
        ['mo', 2592000],
        ['w', 604800],
        ['d', 86400],
        ['h', 3600],
        ['m', 60]
      ];
      for (const [label, size] of units) {
        if (seconds >= size) return Math.floor(seconds / size) + label + ' ago';
      }
      return 'just now';
    }

    function formatSync(branch) {
      if (!branch.upstream) return '';
      if (!branch.ahead && !branch.behind) return '<span title="Up to date with upstream">✓</span>';
      const parts = [];
      if (branch.behind) parts.push('<span class="pull" title="' + branch.behind + ' to pull">↓' + branch.behind + '</span>');
      if (branch.ahead) parts.push('<span class="push" title="' + branch.ahead + ' to push">↑' + branch.ahead + '</span>');
      return parts.join(' ');
    }

    function buildTooltip(item, isTag) {
      const commit = item.lastCommit;
      const lines = [item.name];
      if (commit) {
        lines.push('', 'Commit: ' + commit.sha);
        lines.push('Message: ' + (commit.subject || '(no message)'));
        lines.push('Author: ' + (commit.author || 'unknown'));
        lines.push('Time: ' + (commit.epoch ? new Date(commit.epoch * 1000).toLocaleString() : 'unknown'));
      } else {
        lines.push('', 'No commit information available');
      }
      if (!isTag && item.upstream) {
        lines.push('', 'Upstream: ' + item.upstream);
      }
      return lines.join('\n');
    }

    function applyFilter() {
      const query = searchInput.value.trim().toLowerCase();
      const branchMatches = branches.filter((b) => {
        if (!query) return true;
        return b.name.toLowerCase().includes(query) || (b.shortName && b.shortName.toLowerCase().includes(query));
      });
      const tagMatches = tags.filter((t) => {
        if (!query) return true;
        return t.name.toLowerCase().includes(query);
      });

      branchMatches.sort((a, b) => {
        if (a.current && !b.current) return -1;
        if (b.current && !a.current) return 1;
        const aEpoch = a.lastCommitEpoch || 0;
        const bEpoch = b.lastCommitEpoch || 0;
        if (aEpoch !== bEpoch) return bEpoch - aEpoch;
        return a.name.localeCompare(b.name);
      });

      tagMatches.sort((a, b) => {
        const aEpoch = a.lastCommitEpoch || 0;
        const bEpoch = b.lastCommitEpoch || 0;
        if (aEpoch !== bEpoch) return bEpoch - aEpoch;
        return a.name.localeCompare(b.name);
      });

      filtered = { branches: branchMatches, tags: tagMatches };
      focusedIndex = 0;
      render(query);
    }

    function render(query) {
      const branchCount = filtered.branches.length;
      const tagCount = filtered.tags.length;
      const total = branchCount + tagCount;
      if (isLoading && total === 0) {
        countEl.textContent = 'Loading...';
      } else {
        countEl.textContent = total + (total === 1 ? ' result' : ' results');
      }

      if (isLoading && total === 0) {
        listEl.innerHTML = '<div class="loading">Loading branches and tags…</div>';
        return;
      }

      if (total === 0) {
        listEl.innerHTML = '<div class="empty">No branches or tags match your search.</div>';
        return;
      }

      const localBranches = filtered.branches.filter((b) => b.type === 'local');
      const remoteBranches = filtered.branches.filter((b) => b.type === 'remote');

      const remoteGroups = new Map();
      for (const branch of remoteBranches) {
        const remote = branch.remoteName || 'unknown';
        if (!remoteGroups.has(remote)) remoteGroups.set(remote, []);
        remoteGroups.get(remote).push(branch);
      }

      const sections = [];
      if (localBranches.length > 0) {
        sections.push({ label: 'Local', kind: 'branch', items: localBranches });
      }
      for (const [remoteName, items] of Array.from(remoteGroups.entries()).sort((a, b) => a[0].localeCompare(b[0]))) {
        sections.push({ label: 'Remote: ' + remoteName, kind: 'branch', items });
      }
      if (filtered.tags.length > 0) {
        sections.push({ label: 'Tags', kind: 'tag', items: filtered.tags });
      }

      let globalIndex = 0;
      const html = sections
        .map((section) => {
          const isTag = section.kind === 'tag';
          const withSync = section.label === 'Local';
          const head =
            '<div class="col-head">' +
              '<span></span><span>Name</span><span>Commit</span><span>Author</span><span>Updated</span>' +
              (withSync ? '<span class="cell-sync">Pull / Push</span>' : '') +
              '<span></span>' +
            '</div>';
          const rows = section.items
            .map((item) => {
              const idx = globalIndex++;
              const icon = isTag ? '🏷' : item.current ? '✔' : item.type === 'remote' ? '☁' : '⎇';
              const commit = item.lastCommit;
              const epoch = (commit && commit.epoch) || item.lastCommitEpoch;
              const classes = ['row'];
              if (!isTag && item.current) classes.push('current');
              if (idx === focusedIndex) classes.push('focused');
              const kind = isTag ? 'tag' : 'branch';
              const author = (commit && commit.author) || '';
              return '<div class="' + classes.join(' ') + '" data-index="' + idx + '" data-name="' + escapeHtml(item.name) + '" data-kind="' + kind + '" title="' + escapeHtml(buildTooltip(item, isTag)) + '">' +
                '<span class="row-icon">' + icon + '</span>' +
                '<span class="row-name">' + highlight(item.name, query) + '</span>' +
                '<span class="cell cell-sha">' + escapeHtml(shortSha(item)) + '</span>' +
                '<span class="cell">' + escapeHtml(author) + '</span>' +
                '<span class="cell">' + escapeHtml(formatRelative(epoch)) + '</span>' +
                (withSync ? '<span class="cell cell-sync">' + formatSync(item) + '</span>' : '') +
                '<span class="row-actions">' +
                  '<button data-action="actions" title="More actions">⋯</button>' +
                '</span>' +
                '</div>';
            })
            .join('');
          return '<div class="section' + (withSync ? ' with-sync' : '') + '"><div class="section-title">' + escapeHtml(section.label) + '</div>' + head + rows + '</div>';
        })
        .join('');

      listEl.innerHTML = html;
    }

    function rowsFlat() {
      return Array.from(listEl.querySelectorAll('.row'));
    }

    function focusRow(idx) {
      const rows = rowsFlat();
      if (rows.length === 0) return;
      focusedIndex = Math.max(0, Math.min(idx, rows.length - 1));
      rows.forEach((r, i) => r.classList.toggle('focused', i === focusedIndex));
      const row = rows[focusedIndex];
      if (row) row.scrollIntoView({ block: 'nearest' });
    }

    function closeMenu() {
      if (branchMenu) { branchMenu.classList.remove('visible'); }
      if (tagMenu) { tagMenu.classList.remove('visible'); }
      selectedName = null;
      selectedKind = null;
    }

    function openMenu(x, y, name, kind) {
      const menu = getMenu(kind);
      if (!menu) {
        return;
      }
      selectedName = name;
      selectedKind = kind;
      closeMenu();
      selectedName = name;
      selectedKind = kind;
      menu.style.left = '0px';
      menu.style.top = '0px';
      menu.classList.add('visible');

      const menuRect = menu.getBoundingClientRect();
      const maxX = Math.max(8, window.innerWidth - menuRect.width - 8);
      const maxY = Math.max(8, window.innerHeight - menuRect.height - 8);
      const targetX = Math.max(8, Math.min(x, maxX));
      const targetY = Math.max(8, Math.min(y, maxY));

      menu.style.left = targetX + 'px';
      menu.style.top = targetY + 'px';
    }

    const refreshContextMenu = (() => {
      const menu = document.getElementById('refresh-context-menu');
      if (!menu) { return { close() {}, open() {} }; }
      const close = () => menu.classList.remove('visible');
      const open = (x, y) => {
        menu.style.left = '0px';
        menu.style.top = '0px';
        menu.classList.add('visible');
        const menuRect = menu.getBoundingClientRect();
        const maxX = Math.max(8, window.innerWidth - menuRect.width - 8);
        const maxY = Math.max(8, window.innerHeight - menuRect.height - 8);
        menu.style.left = Math.max(8, Math.min(x, maxX)) + 'px';
        menu.style.top = Math.max(8, Math.min(y, maxY)) + 'px';
      };
      menu.addEventListener('click', (event) => {
        const target = event.target && event.target.closest ? event.target.closest('.menu-item[data-command]') : null;
        if (!target || target.disabled) { return; }
        const command = target.getAttribute('data-command');
        if (command === 'refresh') {
          close();
          vscode.postMessage({ type: 'refresh' });
        }
      });
      window.addEventListener('blur', close);
      window.addEventListener('scroll', close, true);
      return { close, open };
    })();

    searchInput.addEventListener('input', () => {
      closeMenu();
      refreshContextMenu.close();
      applyFilter();
    });

    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        closeMenu();
        refreshContextMenu.close();
        vscode.postMessage({ type: 'refresh' });
      });
    }

    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        const activeMenu = getActiveMenu();
        if (activeMenu && activeMenu.classList.contains('visible')) {
          closeMenu();
          return;
        }
        const refreshMenu = document.getElementById('refresh-context-menu');
        if (refreshMenu && refreshMenu.classList.contains('visible')) {
          refreshContextMenu.close();
          return;
        }
        vscode.postMessage({ type: 'close' });
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        focusRow(focusedIndex + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        focusRow(focusedIndex - 1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const rows = rowsFlat();
        const row = rows[focusedIndex];
        if (row) {
          const kind = row.dataset.kind;
          const name = row.dataset.name;
          if (kind === 'tag') {
            vscode.postMessage({ type: 'checkoutTag', name });
          } else {
            vscode.postMessage({ type: 'checkout', name });
          }
        }
      }
    });

    document.addEventListener('click', (event) => {
      const activeMenu = getActiveMenu();
      if (activeMenu && activeMenu.classList.contains('visible') && !activeMenu.contains(event.target)) {
        closeMenu();
      }
      const refreshMenu = document.getElementById('refresh-context-menu');
      if (refreshMenu && refreshMenu.classList.contains('visible') && !refreshMenu.contains(event.target)) {
        refreshContextMenu.close();
      }
    });

    document.addEventListener('contextmenu', (event) => {
      const row = event.target && event.target.closest ? event.target.closest('.row') : null;
      if (!row) {
        closeMenu();
        refreshContextMenu.close();
        // Let interactive elements keep their native context menu (inputs, textareas, etc.)
        const tag = (event.target && event.target.tagName) ? event.target.tagName.toLowerCase() : '';
        const isInteractive = tag === 'input' || tag === 'textarea' || tag === 'select' || tag === 'button' || (event.target && event.target.isContentEditable);
        if (isInteractive) { return; }
        event.preventDefault();
        refreshContextMenu.open(event.clientX, event.clientY);
        return;
      }

      refreshContextMenu.close();
      event.preventDefault();
      const name = row.dataset.name;
      const kind = row.dataset.kind;
      if (!name) {
        return;
      }

      const idx = Number(row.dataset.index);
      if (Number.isFinite(idx)) {
        focusRow(idx);
      }
      openMenu(event.clientX, event.clientY, name, kind);
    });

    [branchMenu, tagMenu].filter(Boolean).forEach((menuEl) => {
      menuEl.addEventListener('click', (event) => {
        const target = event.target && event.target.closest ? event.target.closest('.menu-item[data-command]') : null;
        if (!target || !selectedName) {
          return;
        }

        const command = target.getAttribute('data-command');
        if (!command) {
          return;
        }

        const msgType = selectedKind === 'tag' ? 'tagCommand' : 'branchCommand';
        vscode.postMessage({ type: msgType, command, name: selectedName });
        closeMenu();
      });
    });

    listEl.addEventListener('click', (e) => {
      const target = e.target;
      const actionBtn = target.closest('button[data-action]');
      const row = target.closest('.row');
      if (!row) return;
      const name = row.dataset.name;
      const kind = row.dataset.kind;
      if (!name) return;
      if (actionBtn && actionBtn.dataset.action === 'actions') {
        e.stopPropagation();
        const rect = actionBtn.getBoundingClientRect();
        openMenu(rect.left, rect.bottom + 4, name, kind);
        return;
      }
      e.stopPropagation();
      const idx = Number(row.dataset.index);
      if (Number.isFinite(idx)) {
        focusRow(idx);
      }
      const rect = row.getBoundingClientRect();
      openMenu(rect.left + 28, rect.bottom + 4, name, kind);
    });
  </script>
{{> partials/documentEnd}}
